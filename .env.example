# Supabase project settings -> Database -> Connection string
# Session pooler (port 5432, IPv4) — used only for drizzle-kit migrations.
# The plain "Direct connection" host is IPv6-only; use the session pooler instead
# on networks without IPv6.
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres

# Pooled connection (port 6543, pgbouncer) — used by the running app.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON_KEY]
